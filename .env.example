# Base URL of the Accelfied API (Accelfied_backend). Must be reachable during `next build`.
API_URL=http://localhost:4000

# Public URL of this website, used for canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the API sends to /api/revalidate after moderation changes.
REVALIDATE_SECRET=change-me-same-as-backend-WEBSITE_REVALIDATE_SECRET

# Optional: serve the account dashboard on its own subdomains (production: companies on
# https://vendor.accelfied.com, clients on https://my.accelfied.com). /dashboard on the main site then
# redirects to the visitor's own subdomain, and public pages on a subdomain redirect back.
# Leave both empty to keep the dashboard on the main site. With only one set, everyone uses it.
# Needs a rebuild after a change.
NEXT_PUBLIC_VENDOR_URL=
NEXT_PUBLIC_CLIENT_URL=
# Share the sign-in cookie between the main site and the dashboard subdomains (production: accelfied.com).
COOKIE_DOMAIN=
