# Base URL of the Accelfied API (Accelfied_backend). Must be reachable during `next build`.
API_URL=http://localhost:4000

# Public URL of this website, used for canonical links, the sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret the API sends to /api/revalidate after moderation changes.
REVALIDATE_SECRET=change-me-same-as-backend-WEBSITE_REVALIDATE_SECRET

# Optional: serve the account dashboard on its own subdomain (production: https://vendor.accelfied.com).
# /dashboard on the main site then redirects there, and public pages on the subdomain redirect back.
# Leave empty to keep the dashboard on the main site. Needs a rebuild after a change.
NEXT_PUBLIC_VENDOR_URL=
# Share the sign-in cookie between the main site and the vendor subdomain (production: accelfied.com).
COOKIE_DOMAIN=
